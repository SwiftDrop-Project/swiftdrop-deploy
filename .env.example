# Copy this file to .env  (cp .env.example .env)  and fill in the values.
# .env is never committed. Share real secrets only in your private team chat.
# Do not put comments at the end of a value line.

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=change-me

# ---------- RabbitMQ ----------
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=change-me

# ---------- Backend security ----------
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
JWT_REMEMBER_ME_DAYS=7

# First admin account, created automatically on first start
ADMIN_EMAIL=admin@swiftdrop.lk
ADMIN_PASSWORD=change-me-123

# Demo accounts (customer, approved merchant, courier) for testing and the demo
SEED_DEMO_USERS=true
DEMO_PASSWORD=Demo12345

# ---------- URLs ----------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---------- Google login ("Continue with Google") ----------
# Leave both Google values empty to turn it off (the backend still starts).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type "Web application"),
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
# Set NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true only when both values are filled in,
# and rebuild the frontend after changing it (docker compose up -d --build frontend).
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
