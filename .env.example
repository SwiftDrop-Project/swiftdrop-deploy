# Copy this file to .env  (cp .env.example .env)  and fill in the values.
# .env is never committed. Share real secrets only in your private team chat.
# Do not put comments at the end of a value line.
# Do not use the $ character in any value: Docker Compose treats it as a variable.

# ---------- Database: the team's shared Neon database ----------
# Neon console > your project > Connect. Pick the DIRECT connection (host ep-...aws.neon.tech),
# not the "-pooler" one: Flyway needs a session connection.
# Neon shows a URL like postgresql://<role>:<password>@<neon-host>/<database>?sslmode=require
# Split it into the three values below. Keep the password out of DB_URL.
# Example:
#   DB_URL=jdbc:postgresql://<neon-host>/swiftdrop?sslmode=require
#   DB_USER=<neon-role>
#   DB_PASSWORD=<neon-password>
# All three are required: docker compose stops with a message if one is empty.
DB_URL=
DB_USER=
DB_PASSWORD=

# ---------- Email: real email through Gmail ----------
# The team's Gmail account needs 2-Step Verification. Create an App Password at
# https://myaccount.google.com/apppasswords and use it as MAIL_PASSWORD
# (16 characters, without the spaces Google shows). It is not the normal Gmail password.
# Example:
#   MAIL_USERNAME=<team-account>@gmail.com
#   MAIL_PASSWORD=<16-character-app-password>
#   MAIL_FROM=<team-account>@gmail.com
# MAIL_FROM should use the same address as MAIL_USERNAME, or Gmail replaces it.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------- RabbitMQ (runs in Docker on your laptop) ----------
RABBITMQ_PORT=5672
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=change-me

# ---------- Backend security ----------
# Required. At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
JWT_REMEMBER_ME_DAYS=7
# HMAC key for the stored 6-digit email codes. Must be at least 32 characters if set.
# Empty means it is derived from JWT_SECRET. With the shared database, use the same value as
# the rest of the team (from the team chat). Generate with: openssl rand -base64 48
VERIFICATION_CODE_SECRET=
# Keep false while the app runs on http://localhost
COOKIE_SECURE=false

# First admin account, created automatically on first start
ADMIN_EMAIL=admin@swiftdrop.lk
ADMIN_PASSWORD=change-me-123

# Demo accounts (customer, approved merchant, courier) for testing and the demo
SEED_DEMO_USERS=true
DEMO_PASSWORD=Demo12345

# ---------- URLs ----------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---------- Google login ("Continue with Google") ----------
# Leave both Google values empty to turn it off (the backend still starts).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type "Web application"),
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
# Set NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true only when both values are filled in,
# and rebuild the frontend after changing it (docker compose up -d --build frontend).
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Local database option only ----------
# Used only with: docker compose -f docker-compose.yml -f docker-compose.local-db.yml up -d --build
# The backend then uses this local PostgreSQL and the Mailpit fake inbox instead of Neon and Gmail.
# DB_URL, DB_USER and DB_PASSWORD above still need a value in this mode, because docker compose
# checks them before it applies the override. Keep your Neon values, or if you have none use:
#   DB_URL=jdbc:postgresql://postgres:5432/swiftdrop
#   DB_USER=swiftdrop
#   DB_PASSWORD=<same as POSTGRES_PASSWORD>
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=change-me
